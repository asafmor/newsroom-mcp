# Path to the SQLite database file. Use ":memory:" for an ephemeral database
# (e.g. tests). The directory is created automatically if it doesn't exist.
NEWSROOM_DB_PATH=data/newsroom.db

# pino log level: trace | debug | info | warn | error | fatal
NEWSROOM_LOG_LEVEL=info

# Hacker News Algolia search query (search_by_date, tags=story).
NEWSROOM_HN_QUERY=AI OR "artificial intelligence" OR LLM OR "machine learning"

# Per-request timeout for every provider's HTTP fetch, in milliseconds.
NEWSROOM_FETCH_TIMEOUT_MS=20000

# Opt-in live sanity tests against real RSS/Hacker News APIs and the
# real MCP tool surface. Normal `npm run verify` does not run live tests.
NEWSROOM_LIVE_TESTS=0
