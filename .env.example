# Path to the SQLite database file. Use ":memory:" for an ephemeral database
# (e.g. tests). The directory is created automatically if it doesn't exist.
NEWSROOM_DB_PATH=data/newsroom.db

# pino log level: trace | debug | info | warn | error | fatal
NEWSROOM_LOG_LEVEL=info

# Hacker News Algolia search query (search_by_date, tags=story).
NEWSROOM_HN_QUERY=AI OR "artificial intelligence" OR LLM OR "machine learning"

# Per-request timeout for every provider's HTTP fetch, in milliseconds.
NEWSROOM_FETCH_TIMEOUT_MS=20000

# Opt-in live sanity tests against real RSS/Hacker News APIs and the
# real MCP tool surface. Normal `npm run verify` does not run live tests.
NEWSROOM_LIVE_TESTS=0

# --- Weekly podcast digest (Phase 2 synthesis) -----------------------------
# The MCP server never reads this — it is NOT part of src/config.ts /
# NewsroomConfig. It's read directly from process.env, script/CI-only, by
# scripts/synthesize-podcast.ts (and the synthesize-podcast.yml workflow,
# where it comes from a repository secret instead of a local .env file).
# git push auth for the `feed` branch needs no separate token: it reuses
# whatever credentials are already configured for `origin` in this checkout.

# OpenAI API key used only for TTS synthesis (audio/speech). Required to run
# scripts/synthesize-podcast.ts locally; never required by `npm run verify`
# or any other npm script, which stub this seam instead of calling it.
OPENAI_API_KEY=

# --- Tool Radar (scripts/publish-tool-radar.ts) -----------------------------
# The MCP server never reads either of these — neither is part of
# src/config.ts/NewsroomConfig. Both are read directly from process.env,
# script/CI-only, and are entirely optional: every request Tool Radar makes
# works (at a lower, unauthenticated rate limit) with no token at all, and
# `npm run verify`/`npm run test` never requires either.

# Raises GitHub Search API's rate limit from 10 req/min to 30 req/min. A
# plain classic/fine-grained token with no scopes is enough (public search
# only).
GITHUB_TOKEN=

# Raises Hugging Face's /api/models and /api/spaces rate limits. A read-only
# HF access token is enough.
HF_TOKEN=
